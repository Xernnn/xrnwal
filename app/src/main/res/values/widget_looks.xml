<?xml version="1.0" encoding="utf-8"?>
<!--
  The widgets' looks, taken from the xrnwal tile: its green, its charcoal and its white, softened so
  neither look is a black or white slab on the home screen. The layouts are themed with WidgetLook.Auto,
  which is Sage here and Moss in values-night, so the launcher follows the phone's light or dark mode.
  WidgetViews reads Sage and Moss by name to draw each chart once in each look.
  Against the surface: ink 11:1, muted 5.3:1 or more, the charts' accent 3.3:1 or more. Going faster
  than the month allows is drawn in the alert colour, which is the ink, not a red.
-->
<resources>
    <declare-styleable name="WidgetLook">
        <attr name="widgetSurface" format="color" />
        <attr name="widgetInk" format="color" />
        <attr name="widgetMuted" format="color" />
        <attr name="widgetAccent" format="color" />
        <attr name="widgetTrack" format="color" />
        <attr name="widgetAlert" format="color" />
        <attr name="widgetDisc" format="color" />
        <attr name="widgetPlus" format="color" />
    </declare-styleable>

    <!-- Light mode: a pale olive grey, charcoal figures, the charts in a deep olive. -->
    <style name="WidgetLook.Sage" parent="">
        <item name="widgetSurface">#D2D8BC</item>
        <item name="widgetInk">#1D2210</item>
        <item name="widgetMuted">#4D5539</item>
        <item name="widgetAccent">#5E7B0E</item>
        <item name="widgetTrack">#BAC39C</item>
        <item name="widgetAlert">#1D2210</item>
        <item name="widgetDisc">#7B9C17</item>
        <item name="widgetPlus">#18181B</item>
    </style>

    <!-- Dark mode: a deep olive, cream figures, the charts in the tile's green lifted. -->
    <style name="WidgetLook.Moss" parent="">
        <item name="widgetSurface">#2D3519</item>
        <item name="widgetInk">#EEF1E0</item>
        <item name="widgetMuted">#B2BA98</item>
        <item name="widgetAccent">#A9C94A</item>
        <item name="widgetTrack">#434D2B</item>
        <item name="widgetAlert">#EEF1E0</item>
        <item name="widgetDisc">#A9C94A</item>
        <item name="widgetPlus">#2D3519</item>
    </style>

    <style name="WidgetLook.Auto" parent="WidgetLook.Sage" />
</resources>
