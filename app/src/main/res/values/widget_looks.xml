<?xml version="1.0" encoding="utf-8"?>
<!--
  The widgets' looks, as theme overlays on each widget's layout. Text and shapes take their colours from
  these, and WidgetViews reads the same ones to draw the charts, so a look is defined once.
  Contrast against the surface: ink 16:1 or more, muted 5.3:1 or more, accentText 5.4:1 or more; the
  charts' accent is 3.2:1 or more and the alert red 4.9:1 or more.
-->
<resources>
    <declare-styleable name="WidgetLook">
        <attr name="widgetSurface" format="color" />
        <attr name="widgetInk" format="color" />
        <attr name="widgetMuted" format="color" />
        <attr name="widgetAccent" format="color" />
        <attr name="widgetAccentText" format="color" />
        <attr name="widgetTrack" format="color" />
        <attr name="widgetFaint" format="color" />
        <attr name="widgetAlert" format="color" />
        <attr name="widgetDisc" format="color" />
        <attr name="widgetPlus" format="color" />
    </declare-styleable>

    <!-- Ink on a pale paper of the tile's green. The ring's green is 3.5:1 on the paper. -->
    <style name="WidgetLook.Pace.Light" parent="">
        <item name="widgetSurface">#F7F9EF</item>
        <item name="widgetInk">#18181B</item>
        <item name="widgetMuted">#5E6553</item>
        <item name="widgetAccent">#6D8F00</item>
        <item name="widgetAccentText">#567400</item>
        <item name="widgetTrack">#E4E9D3</item>
        <item name="widgetFaint">#E4E9D3</item>
        <item name="widgetAlert">#CE2C35</item>
        <item name="widgetDisc">#18181B</item>
        <item name="widgetPlus">#FFFFFF</item>
    </style>

    <!-- Near white on the family black, the ring in a light banknote green (9.0:1). -->
    <style name="WidgetLook.Pace.Dark" parent="">
        <item name="widgetSurface">#18181B</item>
        <item name="widgetInk">#FAFAFA</item>
        <item name="widgetMuted">#A1A1AA</item>
        <item name="widgetAccent">#A4C53E</item>
        <item name="widgetAccentText">#B5D259</item>
        <item name="widgetTrack">#2C2C31</item>
        <item name="widgetFaint">#2C2C31</item>
        <item name="widgetAlert">#FF6961</item>
        <item name="widgetDisc">#A4C53E</item>
        <item name="widgetPlus">#18181B</item>
    </style>

    <!-- White, today's bar in the tile's green (3.2:1), the days before it in a grey of the same hue. -->
    <style name="WidgetLook.Rhythm.Light" parent="">
        <item name="widgetSurface">#FFFFFF</item>
        <item name="widgetInk">#18181B</item>
        <item name="widgetMuted">#6B6B73</item>
        <item name="widgetAccent">#7B9C17</item>
        <item name="widgetAccentText">#567400</item>
        <item name="widgetTrack">#C4C9AB</item>
        <item name="widgetFaint">#E3E6DA</item>
        <item name="widgetAlert">#CE2C35</item>
        <item name="widgetDisc">#7B9C17</item>
        <item name="widgetPlus">#FFFFFF</item>
    </style>

    <!-- The family black, today's bar in a light banknote green (10.4:1). -->
    <style name="WidgetLook.Rhythm.Dark" parent="">
        <item name="widgetSurface">#18181B</item>
        <item name="widgetInk">#FAFAFA</item>
        <item name="widgetMuted">#A1A1AA</item>
        <item name="widgetAccent">#B5D259</item>
        <item name="widgetAccentText">#B5D259</item>
        <item name="widgetTrack">#46464E</item>
        <item name="widgetFaint">#303036</item>
        <item name="widgetAlert">#FF6961</item>
        <item name="widgetDisc">#B5D259</item>
        <item name="widgetPlus">#18181B</item>
    </style>
</resources>
