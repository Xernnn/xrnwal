<?xml version="1.0" encoding="utf-8"?>
<!--
  Rhythm, two by two: today's spending over a bar for each of the last seven days, today's lit. Merged
  into a root themed with one of the looks. Its texts and bars are a made-up sample for the widget
  picker; the app replaces every one.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    tools:parentTag="android.widget.FrameLayout">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="13dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans_semibold"
                android:maxLines="1"
                android:text="Sun 22"
                android:textColor="?attr/widgetMuted"
                android:textSize="13sp" />

            <include layout="@layout/widget_part_add" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/misans_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="$62"
            android:textColor="?attr/widgetInk"
            android:textSize="34sp" />

        <ImageView
            android:id="@+id/widget_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_sample_week" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_day0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans_medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="M"
                android:textColor="?attr/widgetMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_day1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans_medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="T"
                android:textColor="?attr/widgetMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_day2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans_medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="W"
                android:textColor="?attr/widgetMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_day3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans_medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="T"
                android:textColor="?attr/widgetMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_day4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans_medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="F"
                android:textColor="?attr/widgetMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_day5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans_medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="S"
                android:textColor="?attr/widgetMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_day6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans_medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="S"
                android:textColor="?attr/widgetAccentText"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
