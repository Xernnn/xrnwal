<?xml version="1.0" encoding="utf-8"?>
<!-- A widget's "+", in its look's colours. Opens Add bill, so its frame is the button and stays. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_add"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:contentDescription="@string/widget_add"
    tools:ignore="MergeRootFrame">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_disc" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:src="@drawable/ic_widget_add" />
</FrameLayout>
