<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout and the target cells are read from Android 12 on; earlier ones use previewImage and the min sizes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_pace_today_about"
    android:initialLayout="@layout/widget_blank_pace_dark"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_preview_pace_today_dark"
    android:previewLayout="@layout/widget_pace_today_dark"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
