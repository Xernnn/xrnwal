<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout and the target cells are read from Android 12 on; earlier ones use previewImage and the min sizes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_rhythm_month_about"
    android:initialLayout="@layout/widget_blank_rhythm_dark"
    android:minHeight="110dp"
    android:minResizeHeight="130dp"
    android:minResizeWidth="250dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview_rhythm_month_dark"
    android:previewLayout="@layout/widget_rhythm_month_dark"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
