<?xml version="1.0" encoding="utf-8"?>
<!-- Month under its 0.7.0 provider, kept so a widget placed then still draws. Hidden from the picker. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_month_about"
    android:initialLayout="@layout/widget_blank"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="250dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview_month"
    android:previewLayout="@layout/widget_month"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="3600000"
    android:widgetFeatures="hide_from_picker"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
