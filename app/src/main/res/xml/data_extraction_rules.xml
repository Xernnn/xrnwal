<?xml version="1.0" encoding="utf-8"?>
<!--
    From Android 12. allowBackup="false" already keeps the wallet out of Google's cloud backup, but it is
    deprecated there, and on some phones it no longer stops a move to a new phone. So the cloud is told
    here as well: nothing. A move to a new phone keeps its default, everything, as there is no section
    for it. The login doesn't survive one, as its key stays in the old phone's keystore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
</data-extraction-rules>
